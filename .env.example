# Copy to .env.local (local dev) and add the same keys in Vercel → Project → Settings → Environment Variables.
# Leave the Supabase keys empty to run the local demo mode (data in the browser only).

# ── Supabase (Dashboard → Project Settings → API) ──────────────────────────────
# Public: safe to ship to the browser (RLS protects the data).
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Secret: server only (api/*, seed script). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Optional: password given to the demo accounts by `npm run db:seed` (default agusta123).
# SEED_PASSWORD=""

# ── Riset harga pasar barang custom (Google Shopping via Serper.dev) ───────────
# Daftar di https://serper.dev → API key. Kosong = mode manual (tombol buka Google Shopping/Tokopedia/…).
SERPER_API_KEY=""

# ── WhatsApp Business Cloud API (Meta) ─────────────────────────────────────────
# Leave empty → WhatsApp runs in simulation mode (nothing is sent, history says "mode simulasi").
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Approved message template (see docs/backend-setup.md for the exact template content).
WHATSAPP_TEMPLATE_NAME="agusta_quotation_approved"
WHATSAPP_TEMPLATE_LANG="id"
WHATSAPP_API_VERSION="v21.0"
# Portal notifications forwarded to WhatsApp (/api/notification-webhook, called by a Supabase Database Webhook)
WHATSAPP_NOTIFY_TEMPLATE_NAME="agusta_notifikasi"
# Comma list of notification types to forward, or "none". Empty = all except QUOTATION_APPROVED.
WHATSAPP_NOTIFY_TYPES=""
# Shared secret the Supabase webhook sends in the x-webhook-secret header (make up a long random string).
NOTIFY_WEBHOOK_SECRET=""
# Public URL of the portal, used as the link in WhatsApp notifications.
APP_URL="https://agusta-quotation-portal.vercel.app"

# Delivery receipts webhook (/api/whatsapp-webhook)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
